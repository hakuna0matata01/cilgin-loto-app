# Bu dosyayi ".streamlit/secrets.toml" olarak kopyalayip kendi degerlerinizi girin.
# secrets.toml, .gitignore icinde oldugu icin asla GitHub'a commit'lenmez.
#
# Streamlit Community Cloud kullaniyorsaniz, bu dosyayi olusturmaniza gerek
# yok: App settings > Secrets kismina asagidaki satirlari yapistirmaniz yeterli.
#
# GITHUB_TOKEN: "repo" kapsamli (classic) ya da en azindan "Contents: Read and
# write" izinli (fine-grained) bir Personal Access Token.
# Olusturmak icin: https://github.com/settings/tokens
#
# Bu dosya (ve GitHub senkronizasyonu ozelligi) OPSIYONELDIR. Sadece
# Streamlit Cloud gibi dosya sistemi kalici OLMAYAN ortamlarda, Veri Yonetimi
# sekmesinden yapilan manuel girislerin kaybolmamasi icin gereklidir. Kendi
# bilgisayarinizda `streamlit run app.py` ile calistiriyorsaniz gerek yoktur.

GITHUB_TOKEN = "ghp_buraya_kendi_tokeninizi_yazin"
GITHUB_REPO = "kullanici-adiniz/repo-adiniz"
GITHUB_BRANCH = "main"
DB_PATH_IN_REPO = "data/loto.db"
